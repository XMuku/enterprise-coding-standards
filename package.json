{
  "name": "enterprise-coding-standards",
  "version": "1.2.0-beta.5",
  "description": "Pre-code conventions and project adoption templates for AI coding agents",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-kit.mjs",
    "test": "node --test scripts/prepare-project.test.mjs scripts/validate-kit.test.mjs scripts/example-support.test.mjs",
    "check": "npm run validate && npm test",
    "check:examples": "node scripts/check-examples.mjs",
    "test:negative": "node scripts/check-examples.mjs --negative",
    "test:eval-harness": "node scripts/check-eval-harness.mjs"
  }
}
